---
import Button from '../ui/Button';
import RegistrationWrapper from './RegistrationWrapper';
---

<section class="relative min-h-screen flex items-center justify-center overflow-x-hidden overflow-y-auto marine-ocean-effect w-full pt-0">
  <!-- Indicador de scroll (flecha animada) -->
  <div class="absolute bottom-4 sm:bottom-6 md:bottom-8 left-1/2 transform -translate-x-1/2 z-20 fade-in-up" style="animation-delay: 1s;">
    <a 
      href="#about" 
      class="flex flex-col items-center gap-2 text-white hover:text-yellow transition-colors group"
      aria-label="Scroll hacia abajo"
    >
      <span class="font-body text-xs uppercase tracking-wider opacity-80">Scroll</span>
      <svg 
        class="w-6 h-6 animate-bounce opacity-80 group-hover:opacity-100" 
        fill="none" 
        stroke="currentColor" 
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </a>
  </div>

  <!-- Elementos visuales decorativos -->

    <!-- Ola grande - Left Side, Upper Third (fondo decorativo) -->
    <div class="absolute top-[18%] right-0 md:right-2 lg:right-4 z-[1] pointer-events-none opacity-20 md:opacity-30">
      <img 
        src="/sun-xl.png" 
        alt="" 
        class="w-28 md:w-40 lg:w-56 sprite-float-delayed"
        aria-hidden="true"
        loading="lazy"
        onerror="this.onerror=null; this.src='/big-wave.png';"
      />
    </div>
  <!-- Ola grande - Left Side, Upper Third (fondo decorativo) -->
  <div class="absolute top-[18%] left-0 md:left-2 lg:left-4 z-[1] pointer-events-none opacity-20 md:opacity-30">
    <img 
      src="/wage-xl.png" 
      alt="" 
      class="w-28 md:w-40 lg:w-56 sprite-float-delayed"
      aria-hidden="true"
      loading="lazy"
      onerror="this.onerror=null; this.src='/big-wave.png';"
    />
  </div>

  <!-- Ola pequeña - Left Side, Center -->
  <div class="absolute bottom-20 left-10 md:bottom-24 md:left-14 lg:bottom-28 lg:left-18 z-[1] pointer-events-none opacity-20 md:opacity-30 hidden md:block">
    <img 
      src="/sand-cahir.png.png" 
      alt="" 
      class="w-10 md:w-14 lg:w-20 sprite-float"
      aria-hidden="true"
      loading="lazy"
    />
  </div>

  <!-- Tortuga - Bottom Left -->
  <div class="absolute bottom-24 left-4 md:bottom-28 md:left-6 lg:bottom-32 lg:left-8 z-[1] pointer-events-none opacity-25 md:opacity-35">
    <img 
      src="/turtule.png" 
      alt="" 
      class="w-14 md:w-20 lg:w-28 sprite-float-delayed"
      aria-hidden="true"
      loading="lazy"
    />
  </div>

 

  <!-- Ola decorativa - Right Side, Middle (solo tablet/desktop) -->
  <div class="absolute top-[50%] right-12 md:right-20 lg:right-24 z-[1] pointer-events-none opacity-12 md:opacity-20 hidden md:block">
    <img 
      src="/dolfin.png" 
      alt="" 
      class="w-10 md:w-14 lg:w-16 sprite-float"
      aria-hidden="true"
      loading="lazy"
    />
  </div>

  <!-- Faro - Posicionado en esquina inferior derecha, emergiendo desde el borde -->
  <div class="absolute bottom-0 right-0 h-[30vh] md:h-[75vh] lg:h-[85vh] flex items-end z-[2] pointer-events-none overflow-hidden">
    <img 
      src="/faro-xl.png" 
      alt="El Faro de San Mateo" 
      class="opacity-85 md:opacity-95"
      aria-hidden="true"
      loading="eager"
      style="height: 100%; width: auto; max-width: 350px; object-fit: contain; object-position: bottom right; filter: drop-shadow(12px 12px 0px rgba(0,0,0,0.4)); transform: translateY(8%);"
      onerror="this.onerror=null; this.src='/faro.png';"
      id="hero-lighthouse"
    />
    <style>
      @media (min-width: 768px) {
        #hero-lighthouse {
          max-width: 650px !important;
          transform: translateY(3%) !important;
        }
      }
      @media (min-width: 1024px) {
        #hero-lighthouse {
          max-width: 750px !important;
          transform: translateY(0%) !important;
        }
      }
    </style>
  </div>

  <!-- Contenido principal - Layout centrado -->
  <div class="relative z-[10] container mx-auto px-4 sm:px-6 lg:px-8 pt-0 pb-8 sm:pt-6 sm:pb-12 md:pt-8 md:pb-16">
    <div class="max-w-5xl mx-auto text-center">
      
      <!-- Badge "PRESENTADO POR" -->
      <div class="mb-4 fade-in-up">
        <span class="presented-by-badge">PRESENTADO POR</span>
      </div>

      <!-- Logo Tunalia -->
      <div class="mb-6 fade-in-up" style="animation-delay: 0.1s;">
        <img 
          src="/sponsors/tunalia.png" 
          alt="Tunalia" 
          class="animate-pulse-tunalia mx-auto drop-shadow-[4px_4px_0px_rgba(255,255,255,0.3)]"
          style="width: 180px; height: auto;"
          loading="eager"
          id="tunalia-logo-hero"
        />
        <style>
          @media (min-width: 768px) {
            #tunalia-logo-hero {
              width: 240px !important;
            }
          }
        </style>
      </div>

      <!-- Título principal -->
      <h1 class="font-display text-3xl sm:text-4xl md:text-5xl lg:text-6xl mb-3 md:mb-4 text-white leading-[0.95] tracking-tight fade-in-up" style="animation-delay: 0.2s; text-shadow: 2px 2px 4px rgba(0,0,0,0.6), 0 0 20px rgba(0,0,0,0.3);">
        SAN MATEO<br />
        <span class="text-white" style="text-shadow: 3px 3px 6px rgba(0,0,0,0.7), 0 0 25px rgba(0,0,0,0.4);">
          LONGBOARD FESTIVAL
        </span>
      </h1>

      <!-- Subtítulo "COPA TUNALIA" -->
      <p class="copa-tunalia-text text-2xl sm:text-3xl md:text-4xl lg:text-5xl xl:text-6xl mb-3 md:mb-4 fade-in-up" style="animation-delay: 0.3s;">
        COPA TUNALIA
      </p>

      <!-- Edición y Fecha -->
      <div class="mb-6 md:mb-8 fade-in-up" style="animation-delay: 0.4s;">
        <p class="font-heading text-lg sm:text-xl md:text-2xl lg:text-3xl mb-2 text-white font-bold tracking-wide" style="text-shadow: 2px 2px 4px rgba(0,0,0,0.6), 0 0 15px rgba(0,0,0,0.3);">
          III EDICIÓN
        </p>
        <p class="font-heading text-sm sm:text-base md:text-lg lg:text-xl text-white font-semibold tracking-wide" style="text-shadow: 1px 1px 3px rgba(0,0,0,0.6), 0 0 10px rgba(0,0,0,0.3);">
          Diciembre 2025 • El Faro, San Mateo, Manabí, Ecuador
        </p>
      </div>

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-stretch sm:items-center mb-6 md:mb-8 fade-in-up" style="animation-delay: 0.5s;">
        <button
          id="hero-register-btn"
          class="bg-yellow text-black px-6 sm:px-8 py-4 rounded-md font-heading font-bold uppercase tracking-wide border-[3px] border-black shadow-[4px_4px_0px_0px_rgba(26,26,26,1)] hover:shadow-[6px_6px_0px_0px_rgba(26,26,26,1)] hover:-translate-x-[2px] hover:-translate-y-[2px] active:translate-x-[4px] active:translate-y-[4px] active:shadow-[2px_2px_0px_0px_rgba(26,26,26,1)] transition-all min-h-[56px] sm:min-h-[64px] text-base sm:text-lg focus-visible:outline-4 focus-visible:outline-orange focus-visible:outline-offset-4"
          style="background-color: #FFD700;"
        >
          INSCRÍBETE AHORA - $10
        </button>
        <a 
          href="#categories"
          class="w-full sm:w-auto"
        >
          <Button 
            variant="outline" 
            size="large"
            client:load
            className="w-full sm:w-auto !border-white !text-white hover:!bg-white hover:!text-black"
          >
            VER CATEGORÍAS
          </Button>
        </a>
      </div>
    </div>
  </div>
  
  <!-- Modal de Registro -->
  <RegistrationWrapper client:load />
</section>

<script>
  // Manejar apertura del modal desde botones
  if (typeof window !== 'undefined') {
    // Botón del hero
    const heroBtn = document.getElementById('hero-register-btn');
    heroBtn?.addEventListener('click', () => {
      const event = new CustomEvent('open-registration-modal');
      window.dispatchEvent(event);
    });
  }
</script>
