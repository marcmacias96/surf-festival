---
import Button from '../ui/Button';
---

<section class="relative min-h-screen flex items-center justify-center overflow-x-hidden overflow-y-auto marine-ocean-effect w-full pt-0">
  <!-- Indicador de scroll (flecha animada) -->
 

  <!-- Elementos visuales decorativos -->

    <!-- Ola grande - Left Side, Upper Third (fondo decorativo) -->
    <div class="absolute top-[18%] right-0 md:right-2 lg:right-4 z-[1] pointer-events-none opacity-20 md:opacity-30">
      <img 
        src="/sun-xl.png" 
        alt="" 
        class="w-28 md:w-40 lg:w-56 sprite-float-delayed"
        aria-hidden="true"
        loading="lazy"
        onerror="this.onerror=null; this.src='/big-wave.png';"
      />
    </div>
  <!-- Ola grande - Left Side, Upper Third (fondo decorativo) -->
  <div class="absolute top-[18%] left-0 md:left-2 lg:left-4 z-[1] pointer-events-none opacity-20 md:opacity-30">
    <img 
      src="/wage-xl.png" 
      alt="" 
      class="w-28 md:w-40 lg:w-56 sprite-float-delayed"
      aria-hidden="true"
      loading="lazy"
      onerror="this.onerror=null; this.src='/big-wave.png';"
    />
  </div>

  <!-- Ola pequeña - Left Side, Center -->
  <div class="absolute bottom-20 left-10 md:bottom-24 md:left-14 lg:bottom-28 lg:left-18 z-[1] pointer-events-none opacity-20 md:opacity-30 hidden md:block">
    <img 
      src="/sand-cahir.png.png" 
      alt="" 
      class="w-10 md:w-14 lg:w-20 sprite-float"
      aria-hidden="true"
      loading="lazy"
    />
  </div>

  <!-- Tortuga - Bottom Left -->
  <div class="absolute bottom-24 left-4 md:bottom-28 md:left-6 lg:bottom-32 lg:left-8 z-[1] pointer-events-none opacity-25 md:opacity-35">
    <img 
      src="/turtule.png" 
      alt="" 
      class="w-14 md:w-20 lg:w-28 sprite-float-delayed"
      aria-hidden="true"
      loading="lazy"
    />
  </div>

 

  <!-- Ola decorativa - Right Side, Middle (solo tablet/desktop) -->
  <div class="absolute top-[50%] right-12 md:right-20 lg:right-24 z-[1] pointer-events-none opacity-12 md:opacity-20 hidden md:block">
    <img 
      src="/dolfin.png" 
      alt="" 
      class="w-10 md:w-14 lg:w-16 sprite-float"
      aria-hidden="true"
      loading="lazy"
    />
  </div>

  <!-- Faro - Posicionado en esquina inferior derecha, emergiendo desde el borde -->
  <div class="absolute bottom-0 right-0 h-[30vh] md:h-[75vh] lg:h-[85vh] flex items-end z-[2] pointer-events-none overflow-hidden">
    <img 
      src="/faro-xl.png" 
      alt="El Faro de San Mateo" 
      class="opacity-85 md:opacity-95"
      aria-hidden="true"
      loading="eager"
      style="height: 100%; width: auto; max-width: 350px; object-fit: contain; object-position: bottom right; filter: drop-shadow(12px 12px 0px rgba(0,0,0,0.4)); transform: translateY(8%);"
      onerror="this.onerror=null; this.src='/faro.png';"
      id="hero-lighthouse"
    />
    <style>
      @media (min-width: 768px) {
        #hero-lighthouse {
          max-width: 650px !important;
          transform: translateY(3%) !important;
        }
      }
      @media (min-width: 1024px) {
        #hero-lighthouse {
          max-width: 750px !important;
          transform: translateY(0%) !important;
        }
      }
    </style>
  </div>

  <!-- Contenido principal - Layout centrado, optimizado para mobile -->
  <div class="relative z-[10] container mx-auto px-3 sm:px-6 lg:px-8 pt-6 sm:pt-12 md:pt-20 pb-2 sm:pb-8 md:pb-12">
    <div class="max-w-6xl mx-auto text-center">

      <!-- Título principal - DOMINANTE (más grande en mobile) -->
      <h1 class="mb-5 sm:mb-4 md:mb-6 fade-in-up">
        <img
          src="/hero/longfest-text.png"
          alt="San Mateo Longboard Fest"
          class="mx-auto w-[92vw] sm:w-[300px] md:w-[415px] lg:w-[525px] xl:w-[600px] max-w-[600px] h-auto drop-shadow-[4px_4px_0px_rgba(0,0,0,0.6)]"
          loading="eager"
        />
      </h1>

      <!-- Subtítulo "COPA TUNALIA" (más grande en mobile) -->
      <div class="mb-5 sm:mb-3 md:mb-4 fade-in-up" style="animation-delay: 0.1s;">
        <img
          src="/hero/copa-tunalia.png"
          alt="Copa Tunalia"
          class="mx-auto w-[51vw] sm:w-[200px] md:w-[280px] lg:w-[350px] max-w-[350px] h-auto drop-shadow-[2px_2px_0px_rgba(0,0,0,0.5)]"
          loading="eager"
        />
      </div>

      <!-- Edición y Fecha (más grande en mobile) -->
      <div class="mb-6 sm:mb-5 md:mb-6 fade-in-up" style="animation-delay: 0.2s;">
        <img
          src="/hero/faro-3-edicion.png"
          alt="III Edición"
          class="mx-auto w-[45vw] sm:w-[130px] md:w-[180px] lg:w-[220px] max-w-[220px] h-auto mb-3 sm:mb-2 drop-shadow-[2px_2px_0px_rgba(0,0,0,0.5)]"
          loading="eager"
        />
        <p class="font-heading text-sm sm:text-base md:text-lg lg:text-xl text-white font-semibold tracking-wide" style="text-shadow: 2px 2px 4px rgba(0,0,0,0.7), 0 0 15px rgba(0,0,0,0.4);">
          6 de Diciembre 2025 • San Mateo, Manabí, Ecuador
        </p>
      </div>

      <!-- CTAs (compactos en mobile) -->
      <div class="flex flex-row gap-2 sm:gap-3 justify-center items-center mb-5 sm:mb-6 md:mb-8 fade-in-up" style="animation-delay: 0.3s;">
        <a
          href="/longfest"
          class="bg-yellow text-black px-5 sm:px-8 py-2.5 sm:py-4 rounded-md font-heading font-bold uppercase tracking-wide border-2 sm:border-[3px] border-black shadow-[3px_3px_0px_0px_rgba(26,26,26,1)] sm:shadow-[4px_4px_0px_0px_rgba(26,26,26,1)] hover:shadow-[6px_6px_0px_0px_rgba(26,26,26,1)] hover:-translate-x-[2px] hover:-translate-y-[2px] active:translate-x-[4px] active:translate-y-[4px] active:shadow-[2px_2px_0px_0px_rgba(26,26,26,1)] transition-all text-sm sm:text-lg focus-visible:outline-4 focus-visible:outline-orange focus-visible:outline-offset-4 no-underline"
          style="background-color: #FFD700;"
        >
          VER HEATS
        </a>
        <a
          href="#activities"
          class="inline-block"
        >
          <Button
            variant="outline"
            size="large"
            client:load
            className="!px-5 sm:!px-8 !py-2.5 sm:!py-4 !text-sm sm:!text-lg !border-2 sm:!border-[3px] !border-white !text-white hover:!bg-white hover:!text-black !min-h-0"
          >
            VER CRONOGRAMA
          </Button>
        </a>
      </div>

      <!-- Sponsor - Posición secundaria -->
      <div class="fade-in-up" style="animation-delay: 0.4s;">
        <div class="inline-flex flex-col sm:flex-row items-center gap-1 sm:gap-3 bg-white/10 backdrop-blur-sm px-5 sm:px-4 py-2.5 sm:py-2 rounded-2xl sm:rounded-full border border-white/20">
          <span class="text-white/80 text-[10px] sm:text-sm font-body uppercase tracking-wider">Presentado por</span>
          <a href="https://tunalia.com/" target="_blank" rel="noopener noreferrer" aria-label="Visitar Tunalia">
            <img
              src="/sponsors/tunalia.png"
              alt="Tunalia"
              class="h-8 sm:h-8 w-auto"
              loading="eager"
            />
          </a>
        </div>
      </div>
    </div>
  </div>
  
</section>
