---
import Section from '../layout/Section.astro';
import Button from '../ui/Button';

// Sponsors secundarios
const sponsorsSecundarios = [
  { src: '/sponsors/matalhierro.png', alt: 'Matalhierro' },
  { src: '/sponsors/surftel.png', alt: 'Surftel' },
  { src: '/sponsors/manta-surf-hotel.png', alt: 'Manta Surf Hotel' },
  { src: '/sponsors/casa-pulsera.png', alt: 'Casa Pulsera' },
  { src: '/sponsors/asinmar.png', alt: 'Asinmar' },
  { src: '/sponsors/12.png', alt: '12' },
  { src: '/sponsors/nera.png', alt: 'Nera' },
  { src: '/sponsors/nativo.png', alt: 'Nativo' },
  { src: '/sponsors/aguamala.png', alt: 'Aguamala' },
  { src: '/sponsors/susuki.png', alt: 'Susuki' },
  { src: '/sponsors/dr.juan.png', alt: 'Dr. Juan' },
  { src: '/sponsors/bview.png', alt: 'Bview' },
  { src: '/sponsors/hair.png', alt: 'Hair' },
  { src: '/sponsors/albacore.png', alt: 'Albacore' },
  { src: '/sponsors/playa-suits.png', alt: 'Playa Suits' },
  { src: '/sponsors/step-sport.png', alt: 'Step Sport' },
  { src: '/sponsors/nefer.png', alt: 'Nefer' },
  { src: '/sponsors/purisima.png', alt: 'Purisima' },
  { src: '/sponsors/vilavicencio-asociados.png', alt: 'Vilavicencio Asociados' },
  { src: '/sponsors/tacos-gordo.png', alt: 'Tacos Gordo' },
  { src: '/sponsors/launch-time.png', alt: 'Launch Time' },
  { src: '/sponsors/piedra-escondida.png', alt: 'Piedra Escondida' },
  { src: '/sponsors/fish.png', alt: 'Fish' },
  { src: '/sponsors/dolfin.png', alt: 'Dolfin' },
  { src: '/sponsors/monta-states.png', alt: 'Monta States' },
  { src: '/sponsors/san-marino.png', alt: 'San Marino' },
  { src: '/sponsors/optico.png', alt: 'Óptico' },
  { src: '/sponsors/gr-ecua.png', alt: 'GR Ecua' },
  { src: '/sponsors/monchis.png', alt: 'Monchis' },
  { src: '/sponsors/itapoa.png', alt: 'Itapoa' },
];
---

<Section id="sponsors" background="white" class="py-16 sm:py-20 md:py-24 lg:py-32">
  <h2 class="section-title fade-in-up">
    Nuestros Patrocinadores
  </h2>

  <p class="section-subtitle fade-in-up" style="animation-delay: 0.1s;">
    Este evento es posible gracias al apoyo de marcas que creen en nuestra comunidad
  </p>

  <!-- ========== SPONSOR PRINCIPAL - TUNALIA ========== -->
  <div class="sponsor-principal-wrapper fade-in-up" style="animation-delay: 0.2s;">
    <div class="sponsor-principal">
      <!-- Efecto halftone decorativo -->
      <div class="halftone-overlay"></div>

      <!-- Contenido -->
      <div class="sponsor-principal-content">
        <div class="presented-by">
          <span class="presented-line"></span>
          <span class="presented-text">Presentado por</span>
          <span class="presented-line"></span>
        </div>

        <div class="sponsor-principal-logo">
          <img
            src="/sponsors/tunalia.png"
            alt="Tunalia - Patrocinador Oficial del San Mateo Longboard Festival"
          />
        </div>

        <div class="sponsor-badge-container">
          <span class="sponsor-badge">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/>
            </svg>
            Patrocinador Oficial
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/>
            </svg>
          </span>
        </div>

        <p class="sponsor-tagline">
          Impulsando el deporte y la cultura surf en Ecuador
        </p>
      </div>

      <!-- Decoración de esquinas -->
      <div class="corner-decoration top-left"></div>
      <div class="corner-decoration top-right"></div>
      <div class="corner-decoration bottom-left"></div>
      <div class="corner-decoration bottom-right"></div>
    </div>
  </div>

  <!-- ========== SPONSORS COLABORADORES ========== -->
  <div class="collaborators-section fade-in-up" style="animation-delay: 0.3s;">
    <div class="collaborators-header">
      <span class="collaborators-line"></span>
      <h3 class="collaborators-title">Colaboradores Oficiales</h3>
      <span class="collaborators-line"></span>
    </div>

    <p class="collaborators-subtitle">
      Marcas que hacen posible la III Edición del LongFest
    </p>
  </div>

  <div class="sponsors-grid">
    {sponsorsSecundarios.map((sponsor, index) => (
      <div
        class="sponsor-card fade-in-up"
        style={`animation-delay: ${0.35 + index * 0.05}s;`}
      >
        <img
          src={sponsor.src}
          alt={sponsor.alt}
          loading="lazy"
        />
      </div>
    ))}
  </div>

  <!-- ========== CTA PARA NUEVOS SPONSORS ========== -->
  <div class="cta-section fade-in-up" style="animation-delay: 0.9s;">
    <p class="cta-text">¿Quieres ser sponsor?</p>
    <a href="https://wa.me/593969310187" target="_blank" rel="noopener noreferrer">
      <Button variant="outline" client:load>
        Contáctanos
      </Button>
    </a>
  </div>
</Section>

<style>
  .section-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(2.5rem, 5vw + 0.5rem, 4rem);
    text-align: center;
    color: #4A3A70;
    text-transform: uppercase;
    line-height: 1.1;
    margin: 0;
  }

  .section-subtitle {
    font-family: 'Roboto', sans-serif;
    font-size: 1.125rem;
    text-align: center;
    margin-bottom: 3rem;
    color: #666666;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  /* ========== SPONSOR PRINCIPAL - TUNALIA ========== */
  /* Colores de marca Tunalia: Azul/Turquesa */
  .sponsor-principal-wrapper {
    margin-bottom: 4rem;
  }

  .sponsor-principal {
    position: relative;
    background: linear-gradient(135deg, #0099CC 0%, #00B4D8 50%, #48CAE4 100%);
    border: 5px solid #1A1A1A;
    border-radius: 24px;
    box-shadow: 12px 12px 0px #1A1A1A;
    padding: 3rem 2rem;
    max-width: 700px;
    margin: 0 auto;
    overflow: hidden;
  }

  .halftone-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: radial-gradient(circle, rgba(255,255,255,0.15) 1px, transparent 1px);
    background-size: 6px 6px;
    pointer-events: none;
    z-index: 1;
  }

  .sponsor-principal-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .presented-by {
    display: flex;
    align-items: center;
    gap: 1rem;
    width: 100%;
    justify-content: center;
  }

  .presented-line {
    flex: 1;
    max-width: 80px;
    height: 3px;
    background: #FEFDF8;
    border-radius: 2px;
  }

  .presented-text {
    font-family: 'Roboto Condensed', sans-serif;
    font-size: 1rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: #FEFDF8;
  }

  .sponsor-principal-logo {
    background: #FEFDF8;
    border: 4px solid #1A1A1A;
    border-radius: 16px;
    padding: 2rem 3rem;
    box-shadow: 6px 6px 0px rgba(0,0,0,0.3);
  }

  .sponsor-principal-logo img {
    max-width: 320px;
    width: 100%;
    height: auto;
    display: block;
  }

  .sponsor-badge-container {
    display: flex;
    justify-content: center;
  }

  .sponsor-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #FEFDF8;
    color: #006B8F;
    border: 3px solid #1A1A1A;
    font-family: 'Roboto Condensed', sans-serif;
    text-transform: uppercase;
    font-weight: 700;
    font-size: 1rem;
    padding: 0.75rem 1.5rem;
    border-radius: 9999px;
    letter-spacing: 0.05em;
    box-shadow: 3px 3px 0px rgba(0,0,0,0.3);
  }

  .sponsor-badge svg {
    color: #00B4D8;
  }

  .sponsor-tagline {
    font-family: 'Roboto', sans-serif;
    font-size: 1rem;
    color: #FEFDF8;
    text-align: center;
    font-weight: 500;
    margin: 0;
    padding: 0.75rem 1.5rem;
    background: rgba(0,0,0,0.2);
    border-radius: 8px;
  }

  /* Decoración de esquinas */
  .corner-decoration {
    position: absolute;
    width: 24px;
    height: 24px;
    border: 4px solid #FEFDF8;
    z-index: 3;
  }

  .corner-decoration.top-left {
    top: 12px;
    left: 12px;
    border-right: none;
    border-bottom: none;
    border-radius: 8px 0 0 0;
  }

  .corner-decoration.top-right {
    top: 12px;
    right: 12px;
    border-left: none;
    border-bottom: none;
    border-radius: 0 8px 0 0;
  }

  .corner-decoration.bottom-left {
    bottom: 12px;
    left: 12px;
    border-right: none;
    border-top: none;
    border-radius: 0 0 0 8px;
  }

  .corner-decoration.bottom-right {
    bottom: 12px;
    right: 12px;
    border-left: none;
    border-top: none;
    border-radius: 0 0 8px 0;
  }

  /* ========== COLABORADORES ========== */
  .collaborators-section {
    margin-bottom: 2rem;
  }

  .collaborators-header {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .collaborators-line {
    flex: 1;
    max-width: 120px;
    height: 3px;
    background: linear-gradient(90deg, transparent, #4A3A70, transparent);
  }

  .collaborators-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: #4A3A70;
    text-transform: uppercase;
    margin: 0;
    letter-spacing: 0.05em;
  }

  .collaborators-subtitle {
    font-family: 'Roboto', sans-serif;
    font-size: 1rem;
    text-align: center;
    color: #666666;
    margin: 0;
  }

  /* ========== GRID DE SPONSORS ========== */
  .sponsors-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
    margin-bottom: 4rem;
  }

  @media (min-width: 640px) {
    .sponsors-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    .sponsors-grid {
      grid-template-columns: repeat(5, 1fr);
      gap: 1.5rem;
    }
  }

  /* ========== CARD DE SPONSOR ========== */
  .sponsor-card {
    position: relative;
    aspect-ratio: 1;
    background: #FEF7E8;
    border: 3px solid #1A1A1A;
    border-radius: 12px;
    box-shadow: 5px 5px 0px #1A1A1A;
    overflow: hidden;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
  }

  .sponsor-card:hover {
    transform: translate(-3px, -3px);
    box-shadow: 8px 8px 0px #1A1A1A;
  }

  .sponsor-card img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* ========== CTA SECTION ========== */
  .cta-section {
    text-align: center;
    padding-top: 1.5rem;
    border-top: 2px dashed #E0E0E0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .cta-text {
    font-family: 'Roboto Condensed', sans-serif;
    font-size: 1.125rem;
    font-weight: 600;
    color: #2D2D2D;
    margin: 0;
  }

  /* ========== ANIMACIONES ========== */
  .fade-in-up {
    opacity: 0;
    transform: translateY(30px);
    animation: fadeInUp 0.6s ease forwards;
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ========== RESPONSIVE ========== */
  @media (max-width: 640px) {
    .sponsor-principal {
      padding: 2rem 1.5rem;
    }

    .sponsor-principal-logo {
      padding: 1.5rem;
    }

    .sponsor-principal-logo img {
      max-width: 220px;
    }

    .flower-icon {
      width: 24px;
      height: 24px;
    }

    .corner-decoration {
      width: 16px;
      height: 16px;
      border-width: 3px;
    }

    .cta-card {
      padding: 2rem 1.5rem;
    }
  }

  /* ========== REDUCED MOTION ========== */
  @media (prefers-reduced-motion: reduce) {
    .fade-in-up {
      animation: none;
      opacity: 1;
      transform: none;
    }

    .sponsor-card {
      transition: none;
    }

    .sponsor-card:hover {
      transform: none;
    }

    .sponsor-card-shine {
      display: none;
    }
  }
</style>
