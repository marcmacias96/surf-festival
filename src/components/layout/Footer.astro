---
---

<footer class="bg-black text-white-warm py-12 md:py-16">
  <div class="container mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12">
      <!-- Información del Festival -->
      <div class="flex flex-col items-center md:items-start">
        <!-- Escudo del Festival -->
        <div class="mb-6 fade-in-up">
          <img 
            src="/logo_xl.png" 
            alt="Escudo San Mateo Longboard Festival" 
            class="w-32 md:w-40 mx-auto md:mx-0 drop-shadow-[4px_4px_0px_rgba(255,255,255,0.1)]"
            loading="lazy"
          />
        </div>
        <h3 class="font-display text-2xl mb-4 text-center md:text-left">🏄 San Mateo Longboard Festival</h3>
        <p class="font-body text-sm mb-4 text-center md:text-left">
          El festival de longboard más importante de Ecuador. 
          Celebrando la cultura surf y la comunidad costeña.
        </p>
        <p class="font-body text-sm text-center md:text-left">
          III Edición • Diciembre 2025<br />
          El Faro, San Mateo, Manabí, Ecuador
        </p>
      </div>

      <!-- Navegación -->
      <div>
        <h4 class="font-heading text-lg font-bold uppercase mb-4">Navegación</h4>
        <ul class="space-y-2">
          <li><a href="#about" class="font-body text-sm hover:text-yellow transition-colors">Sobre el Festival</a></li>
          <li><a href="#categories" class="font-body text-sm hover:text-yellow transition-colors">Categorías</a></li>
          <li><a href="#prizes" class="font-body text-sm hover:text-yellow transition-colors">Premios</a></li>
          <li><a href="#activities" class="font-body text-sm hover:text-yellow transition-colors">Actividades</a></li>
          <li><a href="#contact" class="font-body text-sm hover:text-yellow transition-colors">Contacto</a></li>
        </ul>
      </div>

      <!-- Contacto -->
      <div>
        <h4 class="font-heading text-lg font-bold uppercase mb-4">Contacto</h4>
        <div class="space-y-3">
          <div>
            <p class="font-heading text-sm font-semibold mb-1">Angelo Franco</p>
            <p class="font-body text-xs text-gray-light">Coordinador del Festival</p>
          </div>
          <div>
            <a 
              href="https://wa.me/593969310187" 
              target="_blank" 
              rel="noopener noreferrer"
              class="font-body text-sm hover:text-yellow transition-colors flex items-center gap-2"
            >
              📱 WhatsApp: +593 96 931 0187
            </a>
          </div>
          <div>
            <a 
              href="mailto:sanmateolongfestival@gmail.com"
              class="font-body text-sm hover:text-yellow transition-colors flex items-center gap-2"
            >
              ✉️ sanmateolongfestival@gmail.com
            </a>
          </div>
          <div class="flex gap-4 mt-4">
            <a href="#" class="text-2xl hover:scale-110 transition-transform" aria-label="Instagram">
              📷
            </a>
            <a href="#" class="text-2xl hover:scale-110 transition-transform" aria-label="Facebook">
              📘
            </a>
            <a href="#" class="text-2xl hover:scale-110 transition-transform" aria-label="TikTok">
              🎵
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Patrocinador Principal -->
    <div class="border-t-2 border-gray-light mt-8 pt-8">
      <div class="flex flex-col md:flex-row items-center justify-center gap-4 md:gap-6">
        <p class="font-body text-sm text-gray-light text-center md:text-left">
          Presentado por
        </p>
        <a href="https://tunalia.com/" target="_blank" rel="noopener noreferrer" aria-label="Visitar Tunalia">
          <img
            src="/sponsors/tunalia.png"
            alt="Tunalia"
            class="h-12 md:h-16 opacity-90 hover:opacity-100 transition-opacity"
            loading="lazy"
          />
        </a>
      </div>
    </div>

    <!-- Copyright -->
    <div class="border-t-2 border-gray-light mt-6 pt-6 text-center">
      <p class="font-body text-xs text-gray-light">
        © 2025 San Mateo Longboard Festival. Todos los derechos reservados.
      </p>
    </div>
  </div>
</footer>

