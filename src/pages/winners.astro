    const defaults = {
      particleCount: 100,
      spread: 70,
      colors: COLORS,
      disableForReducedMotion: true,
    };
    confetti({ ...defaults, ...options });
  }

  // Celebration burst effect (multiple shots from sides)
  function celebrationBurst() {
    const duration = 1000;
    const end = Date.now() + duration;

    (function frame() {
      // Left side
      fireConfetti({
        particleCount: 40,
        angle: 60,
        spread: 55,
        origin: { x: 0, y: 0.6 },
        startVelocity: 55,
      });
      // Right side
      fireConfetti({
        particleCount: 40,
        angle: 120,
        spread: 55,
        origin: { x: 1, y: 0.6 },
        startVelocity: 55,
      });

      if (Date.now() < end) {
        requestAnimationFrame(frame);
      }
    })();
  }

  // Fire confetti from element position (for podiums)
  function fireFromElement(element: Element) {
    const rect = element.getBoundingClientRect();
    const x = (rect.left + rect.width / 2) / window.innerWidth;
    const y = (rect.top + rect.height / 3) / window.innerHeight;

    fireConfetti({
      particleCount: 60,
      spread: 70,
      origin: { x, y },
      startVelocity: 35,
      gravity: 1,
      scalar: 1,
      ticks: 180,
    });
  }

  // Initialize
  function init() {
    // Initial celebration burst on page load (full screen effect)
    setTimeout(() => {
      celebrationBurst();
    }, 500);

    // Setup podium interactions - only on user interaction
    const categoryPodiums = document.querySelectorAll('.category-podium');
    const isMobile = window.matchMedia('(pointer: coarse)').matches;

    categoryPodiums.forEach((podium) => {
      if (isMobile) {
        // Mobile: only click triggers confetti
        podium.addEventListener('click', (e) => {
          const target = e.target as HTMLElement;
          if (target?.closest('a')) return;
          e.stopPropagation();
          fireFromElement(podium);
        });
      } else {
        // Desktop: only hover triggers confetti (once per hover cycle)
        let canTrigger = true;

        podium.addEventListener('mouseenter', () => {
          if (canTrigger) {
            canTrigger = false;
            fireFromElement(podium);
          }
        });

        podium.addEventListener('mouseleave', () => {
          // Reset after leaving, so next hover can trigger again
          canTrigger = true;
        });
      }
    });
  }

  // Run init when DOM is ready or immediately if already loaded
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
